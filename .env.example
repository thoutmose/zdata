# Copy to `.env` and fill in real values. Never commit `.env`.
# Leaving the DB_* variables unset runs the app on deterministic sample data.

# "development" or "production" — also selects the logging.yml profile
# (development: verbose, all files + console; production: INFO+, fewer files).
APP_ENV=development

# --- Database (PostgreSQL) ---
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=

# --- Connection pool (tune for expected concurrent users) ---
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE_S=1800
DB_STATEMENT_TIMEOUT_MS=15000

# --- dbt docs (optional) ---
# URL of a hosted `dbt docs generate` build (real per-model lineage graph,
# column-level docs) — this app can't build or read that itself, it just
# links to it once you host it somewhere. Leave unset to hide the link.
DBT_DOCS_URL=
